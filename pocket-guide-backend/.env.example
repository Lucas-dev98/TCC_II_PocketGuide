APP_NAME=PocketGuide Backend
APP_ENV=development
PORT=8080
AUTH_BYPASS=true

# Firebase
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=false

# Rate limiting
RATE_LIMIT_PER_MIN=120

# Itinerary queue worker
ENABLE_ITINERARY_WORKER=false

# Postgres
USE_POSTGRES=false
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pocketguide?sslmode=disable

# Gemini (server-side)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SEC=30
GEMINI_MAX_RETRIES=3
