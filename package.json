{
  "name": "pocket-guide-monorepo",
  "version": "1.0.0",
  "description": "AI-powered travel itinerary app - React Web",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "cd pocket-guide-web && npm run dev",
    "build": "cd pocket-guide-web && npm run build",
    "preview": "cd pocket-guide-web && npm run preview",
    "type-check": "cd pocket-guide-web && npm run type-check",
    "lint": "cd pocket-guide-web && npm run lint",
    "test": "cd pocket-guide-web && npm run test",
    "test:watch": "cd pocket-guide-web && npm run test:watch",
    "test:coverage": "cd pocket-guide-web && npm run test:coverage",
    "install:web": "cd pocket-guide-web && npm install",
    "deploy": "cd pocket-guide-web && vercel --prod"
  },
  "keywords": [
    "travel",
    "itinerary",
    "ai",
    "gemini",
    "mapbox",
    "react",
    "typescript"
  ],
  "author": "Lucas Bastos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lucas-dev98/TCC_II_PocketGuide.git"
  }
}
