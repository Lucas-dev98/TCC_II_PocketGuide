# ============================================
# POCKET GUIDE - CONFIGURAÇÃO DE AMBIENTE
# ============================================
# Copie este arquivo para .env e preencha com suas credenciais

# ============================================
# FIREBASE CONFIGURATION
# ============================================
# Obtenha em: https://console.firebase.google.com
# Projeto > Configurações > Chaves da Web

EXPO_PUBLIC_FIREBASE_API_KEY=AIza...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123def456

# ============================================
# GOOGLE APIS
# ============================================
# Obtenha em: https://console.cloud.google.com
# Ative: Maps SDK, Places API, Directions API

EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=AIza...

# ============================================
# GEMINI API
# ============================================
# Obtenha em: https://aistudio.google.com
# Clique em "Create API Key"

EXPO_PUBLIC_GEMINI_KEY=AIza...

# ============================================
# OUTRAS CONFIGURAÇÕES (Opcional)
# ============================================

# Modo Debug (true/false)
DEBUG_MODE=false

# Ambiente (development, staging, production)
APP_ENV=development

# URL da API Backend (se existir)
API_BASE_URL=https://api.pocket-guide.com

# Timeout de requisições (ms)
API_TIMEOUT=30000

# ============================================
# INSTRUÇÕES DE PREENCHIMENTO
# ============================================
#
# 1. FIREBASE:
#    - Crie projeto em Firebase Console
#    - Crie app web
#    - Copie as chaves exatas do SDK
#    - Ative Google Sign-In em Auth > Sign-in providers
#
# 2. GOOGLE CLOUD:
#    - Crie projeto em Google Cloud Console
#    - Ative: Maps SDK, Places API, Directions API
#    - Crie API Key REST
#    - Configure restrições de IP (production)
#
# 3. GEMINI:
#    - Acesse Google AI Studio
#    - Clique "Create API Key"
#    - Use a chave gerada
#
# ⚠️  SEGURANÇA:
#    - NUNCA faça commit do .env com chaves reais
#    - Use .env para desenvolvimento local
#    - Em production, use variáveis de ambiente do servidor
#    - Revogue chaves comprometidas imediatamente
