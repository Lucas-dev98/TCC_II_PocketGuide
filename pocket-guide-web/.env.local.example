# ============================================
# POCKET GUIDE WEB - CONFIGURAÇÃO LOCAL
# ============================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env.local
# 2. Preencha com suas chaves reais do Firebase e Google Cloud
# 3. NUNCA faça commit de .env.local com chaves reais
# 4. Use apenas para desenvolvimento local

# ============================================
# FIREBASE CONFIGURATION
# ============================================
# Obtenha em: https://console.firebase.google.com
# Projeto > Configurações > Geral > Seu app web

VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_API_KEY=AIzaSyXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxX
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://seu-projeto.firebaseio.com
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123def456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXX

# ============================================
# GOOGLE CLOUD APIS
# ============================================
# Obtenha em: https://console.cloud.google.com
# APIs & Services > Credentials

VITE_GOOGLE_MAPS_API_KEY=AIzaSyXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxX
VITE_GEMINI_API_KEY=AIzaSyXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxX

# Mapbox Public Token (for map style + geocoding)
VITE_MAPBOX_API_KEY=pk.eyJ1Ijoic2V1dXN1YXJpbyIsImEiOiJjb2xvY2FydG9rZW5hcXVpIn0.XXXXXXXXXXXXXXXXXXXX

# Se quiser forçar OSM em vez do estilo Mapbox, use false.
# Se omitido, o estilo Mapbox é usado automaticamente quando VITE_MAPBOX_API_KEY existir.
VITE_MAPBOX_STYLE_ENABLED=true

# Backend obrigatorio para persistencia (PostgreSQL via API Go)
VITE_BACKEND_URL=http://127.0.0.1:8080

# ============================================
# REFERÊNCIA - ONDE ENCONTRAR CADA VALOR
# ============================================
#
# FIREBASE PROJECT ID:
#   → Firebase Console > Project Settings > General > projectId
#
# FIREBASE API KEY:
#   → Firebase Console > Project Settings > General > apiKey
#   → Deve começar com "AIza"
#
# FIREBASE AUTH DOMAIN:
#   → Firebase Console > Project Settings > General > authDomain
#   → Formato: seu-projeto.firebaseapp.com
#
# FIREBASE DATABASE URL:
#   → Firebase Console > Realtime Database
#   → Ou formado como: https://seu-projeto.firebaseio.com
#
# FIREBASE STORAGE BUCKET:
#   → Firebase Console > Project Settings > General > storageBucket
#   → Formato: seu-projeto.appspot.com
#
# FIREBASE MESSAGING SENDER ID:
#   → Firebase Console > Project Settings > General > messagingSenderId
#   → É um número
#
# FIREBASE APP ID:
#   → Firebase Console > Project Settings > General > appId
#   → Formato: 1:123456789:web:abc123def456
#
# FIREBASE MEASUREMENT ID:
#   → Firebase Console > Project Settings > General > measurementId
#   → Formato: G-XXXXXXXX
#
# GOOGLE MAPS API KEY:
#   → Google Cloud Console > APIs & Services > Credentials
#   → Create API Key > Restrict to Maps APIs
#
# GEMINI API KEY:
#   → Google Cloud Console > APIs & Services > Credentials
#   → Create API Key > Restrict to Generative Language API
#
# ============================================
# ATIVAÇÃO DE APIS NO GOOGLE CLOUD
# ============================================
#
# Certifique-se de ativar estas APIs:
#   ✓ Maps JavaScript API
#   ✓ Generative Language API (Gemini)
#   ✓ Google Maps Platform
#
# ============================================
