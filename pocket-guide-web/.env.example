# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project details

# Firebase Project ID (found in Firebase Console)
VITE_FIREBASE_PROJECT_ID=your_project_id

# Firebase API Key (found in Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=your_api_key

# Firebase Auth Domain (usually project_id.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# Firebase Database URL (for Realtime Database, if used)
VITE_FIREBASE_DATABASE_URL=https://your_project_id.firebaseio.com

# Firebase Storage Bucket (usually project_id.appspot.com)
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# Firebase Messaging Sender ID (found in Firebase Console)
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# Unsplash API for fetching attraction images
# Register at https://unsplash.com/developers and create an application
# Get your Access Key from the application settings
VITE_UNSPLASH_API_KEY=your_unsplash_access_key

# Firebase App ID (found in Firebase Console)
VITE_FIREBASE_APP_ID=your_app_id

# Firebase Measurement ID (optional, for Google Analytics)
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Gemini API Key (for AI itinerary generation)
VITE_GEMINI_API_KEY=your_gemini_api_key

# Google Maps API Key (for map display)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Mapbox API key (for geocoding and optional map style)
# Get at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_API_KEY=pk.your_mapbox_public_token

# Optional: disable Mapbox style and force OSM base map.
# Accepted false values: 0, false, no, off
# If omitted, Mapbox style is enabled automatically when VITE_MAPBOX_API_KEY is set.
VITE_MAPBOX_STYLE_ENABLED=true

# Sentry DSN for crash reporting
# Register at https://sentry.io and create a new project
# Get your DSN from the project settings
VITE_SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/your_project_id

# App Environment
VITE_APP_ENV=production

# Backend API URL (Go backend)
VITE_BACKEND_URL=http://localhost:8080

# In development, backend calls are disabled by default.
# Set to true only if your backend is running locally.
VITE_USE_BACKEND_API=false

# Notes:
# 1. In development, rename this file to .env.local and fill in your values
# 2. Never commit .env.local to version control
# 3. For Vercel deployment, add these environment variables in Project Settings
# 4. Use VITE_ prefix for variables that should be exposed to the browser
