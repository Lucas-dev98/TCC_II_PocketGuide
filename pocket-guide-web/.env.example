# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project details

# Firebase Project ID (found in Firebase Console)
VITE_FIREBASE_PROJECT_ID=your_project_id

# Firebase API Key (found in Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=your_api_key

# Firebase Auth Domain (usually project_id.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# Firebase Database URL (for Realtime Database, if used)
VITE_FIREBASE_DATABASE_URL=https://your_project_id.firebaseio.com

# Firebase Storage Bucket (usually project_id.appspot.com)
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# Firebase Messaging Sender ID (found in Firebase Console)
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# Firebase App ID (found in Firebase Console)
VITE_FIREBASE_APP_ID=your_app_id

# Firebase Measurement ID (optional, for Google Analytics)
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Gemini API Key (for AI itinerary generation)
VITE_GEMINI_API_KEY=your_gemini_api_key

# Google Maps API Key (for map display)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# App Environment
VITE_APP_ENV=production

# Notes:
# 1. In development, rename this file to .env.local and fill in your values
# 2. Never commit .env.local to version control
# 3. For Vercel deployment, add these environment variables in Project Settings
# 4. Use VITE_ prefix for variables that should be exposed to the browser
